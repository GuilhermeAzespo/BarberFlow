# ─────────────────────────────────────────────
# BarberFlow — variáveis de ambiente (docker-compose)
# Copie para .env e ajuste os valores.
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=barberflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=barberflow

# API (apps/server)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
# true quando o domínio público estiver com HTTPS (Easypanel faz isso automaticamente)
COOKIE_SECURE=false
LOG_LEVEL=info
TRIAL_DAYS=14
BILLING_GRACE_DAYS=5
WHATSAPP_ENABLED=true

# Super Admin criado automaticamente no primeiro boot
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@barberflow.app
SUPER_ADMIN_PASSWORD=troque-esta-senha-admin

# Portas expostas apenas no docker-compose.dev.yml (uso local)
WEB_PORT=3000
API_PORT=4000
DB_PORT=5432
