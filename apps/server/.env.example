# Desenvolvimento local da API (npm run dev)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://barberflow:troque-esta-senha@localhost:5432/barberflow?schema=public
JWT_SECRET=dev-secret-com-pelo-menos-32-caracteres-aqui
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
# Origens extras permitidas (separadas por vírgula). Em produção o front usa o proxy /api, então não é necessário.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
TRIAL_DAYS=14
BILLING_GRACE_DAYS=5
WHATSAPP_ENABLED=true
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@barberflow.app
SUPER_ADMIN_PASSWORD=admin12345
