// ─────────────────────────────────────────────────────────────
// BarberFlow — Prisma Schema
//
// Estratégia multi-tenant: banco compartilhado + isolamento lógico.
// Toda entidade de negócio carrega `tenantId` (FK com ON DELETE CASCADE)
// e índices compostos iniciados por `tenantId`, garantindo que todas as
// consultas sejam filtradas e performáticas por salão.
//
// Valores monetários são armazenados em centavos (Int) para evitar
// erros de ponto flutuante. Datas são persistidas em UTC; o fuso de
// cada salão fica em `Tenant.timezone`.
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  SUPER_ADMIN // Gestão do SaaS (sem tenant)
  OWNER // Dono do salão
  MANAGER // Gerente/recepção
  PROFESSIONAL // Profissional com acesso ao painel
}

enum TenantStatus {
  ACTIVE
  SUSPENDED // Suspensão administrativa (suporte, abuso, solicitação)
  BLOCKED // Bloqueio por inadimplência
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
  DELAYED
}

enum AppointmentSource {
  PANEL
  WHATSAPP
  WEB
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  OTHER
}

enum WhatsAppStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ─────────────────────────── SaaS / Billing ───────────────────────────

model Plan {
  id                      String         @id @default(cuid())
  name                    String
  slug                    String         @unique
  description             String?
  priceCents              Int            @default(0)
  // null = ilimitado
  maxProfessionals        Int?
  maxAppointmentsPerMonth Int?
  whatsappEnabled         Boolean        @default(true)
  isActive                Boolean        @default(true)
  isDefault               Boolean        @default(false)
  sortOrder               Int            @default(0)
  features                Json?
  badge                   String?
  isHighlighted           Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  subscriptions           Subscription[]
  saasPayments            SaaSPayment[]
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  customDomain        String?      @unique
  logoUrl             String?
  phone               String?
  email               String?
  address             String?
  bio                 String?
  instagram           String?
  coverUrl            String?
  timezone            String       @default("America/Sao_Paulo")
  currency            String       @default("BRL")
  slotIntervalMinutes Int          @default(30)
  onboardingCompleted Boolean      @default(false)
  status              TenantStatus @default(ACTIVE)
  statusReason        String?
  statusChangedAt     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  subscription          Subscription?
  logo                  TenantLogo?
  cover                 TenantCover?
  galleryImages         TenantGalleryImage[]
  users                 User[]
  businessHours         BusinessHour[]
  professionals         Professional[]
  services              Service[]
  customers             Customer[]
  appointments          Appointment[]
  transactions          Transaction[]
  whatsAppConfig        WhatsAppConfig?
  whatsAppSessionKeys   WhatsAppSessionKey[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  satisfactionSurveys   SatisfactionSurvey[]
  saasPayments          SaaSPayment[]
  logs                  SystemLog[]

  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id                       String             @id @default(cuid())
  tenantId                 String             @unique
  planId                   String
  status                   SubscriptionStatus @default(TRIALING)
  trialEndsAt              DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  canceledAt               DateTime?
  lastPaymentAt            DateTime?
  // Ajustes de limite por cliente (sobrescrevem o plano quando definidos)
  maxProfessionalsOverride Int?
  maxAppointmentsOverride  Int?
  notes                    String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
}

model TenantLogo {
  tenantId  String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantCover {
  tenantId  String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantGalleryImage {
  id        String   @id @default(cuid())
  tenantId  String
  title     String?
  mimeType  String
  data      Bytes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sortOrder])
}

// ───────────────────────────── Identidade ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(OWNER)
  permissions  Json?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional?
  transactions Transaction[]

  @@index([tenantId])
}

// ─────────────────────────── Configurações ───────────────────────────

model BusinessHour {
  id         String  @id @default(cuid())
  tenantId   String
  // 0 = domingo ... 6 = sábado
  weekday    Int
  isOpen     Boolean @default(true)
  // Formato HH:mm no fuso do salão
  openTime   String  @default("09:00")
  closeTime  String  @default("19:00")
  breakStart String?
  breakEnd   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
}

// ───────────────────────────── Operação ─────────────────────────────

model Professional {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String?  @unique
  name              String
  phone             String?
  email             String?
  avatarUrl         String?
  color             String   @default("#C9A227")
  commissionPercent Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services            ProfessionalService[]
  appointments        Appointment[]
  satisfactionSurveys SatisfactionSurvey[]
  avatar              ProfessionalAvatar?

  @@index([tenantId, isActive])
}

model ProfessionalAvatar {
  professionalId String       @id
  mimeType       String
  data           Bytes
  updatedAt      DateTime     @updatedAt

  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  promoPriceCents Int?
  promoTitle      String?
  promoActive     Boolean   @default(false)
  promoExpiresAt  DateTime?
  promoDaysOfWeek Int[]     @default([])
  isActive        Boolean   @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([tenantId, isActive])
}

// Profissional sem nenhum vínculo = atende todos os serviços.
model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  // Apenas dígitos, com DDI (ex: 5511999998888)
  phone        String?
  whatsappJid  String?
  email        String?
  birthDate    DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, phone])
  @@unique([tenantId, whatsappJid])
  @@index([tenantId, name])
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  customerId     String
  professionalId String
  serviceId      String
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(SCHEDULED)
  source         AppointmentSource @default(PANEL)
  priceCents     Int
  notes          String?
  reminderSentAt DateTime?
  canceledAt     DateTime?
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service             Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  transaction         Transaction?
  satisfactionSurveys SatisfactionSurvey[]

  @@index([tenantId, startAt])
  @@index([tenantId, professionalId, startAt])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([reminderSentAt, startAt])
}

model Transaction {
  id            String          @id @default(cuid())
  tenantId      String
  type          TransactionType
  category      String
  description   String?
  amountCents   Int
  paymentMethod PaymentMethod   @default(CASH)
  occurredAt    DateTime        @default(now())
  appointmentId String?         @unique
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, type, occurredAt])
}

// ───────────────────────────── WhatsApp ─────────────────────────────

model WhatsAppConfig {
  id                  String         @id @default(cuid())
  tenantId            String         @unique
  status              WhatsAppStatus @default(DISCONNECTED)
  phoneNumber         String?
  botEnabled          Boolean        @default(true)
  welcomeMessage      String         @db.Text
  confirmationMessage String         @db.Text
  reminderMessage     String         @db.Text
  cancellationMessage String         @db.Text
  reminderEnabled     Boolean        @default(true)
  reminderHoursBefore Int            @default(2)
  attendantSurveyEnabled Boolean     @default(true)
  attendantSurveyMessage String?     @db.Text
  serviceSurveyEnabled   Boolean     @default(true)
  serviceSurveyMessage   String?     @db.Text
  lastConnectedAt     DateTime?
  lastDisconnectedAt  DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Credenciais/chaves Signal da sessão Baileys persistidas no Postgres
// (o container fica stateless: reinícios/deploys não derrubam a sessão).
model WhatsAppSessionKey {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

// Estado da conversa do bot / chat de atendimento por contato.
model WhatsAppConversation {
  id            String            @id @default(cuid())
  tenantId      String
  contactJid    String
  phone         String?
  contactName   String?
  state         String            @default("MENU")
  isAttendant   Boolean           @default(false)
  unreadCount   Int               @default(0)
  lastMessage   String?           @db.Text
  context       Json              @default("{}")
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@unique([tenantId, contactJid])
  @@index([tenantId, isAttendant, lastMessageAt])
}

// Histórico de mensagens do chat do WhatsApp (recebidas e enviadas).
model WhatsAppMessage {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  contactJid     String
  fromMe         Boolean  @default(false)
  senderType     String   @default("CUSTOMER") // CUSTOMER, BOT, ATTENDANT, SYSTEM
  senderName     String?
  body           String   @db.Text
  status         String   @default("SENT") // SENT, DELIVERED, READ
  createdAt      DateTime @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, contactJid])
}

// Pesquisa de Satisfação (Atendimento Humano ou Pós-Corte/Agendamento).
model SatisfactionSurvey {
  id             String    @id @default(cuid())
  tenantId       String
  type           String    // "ATTENDANT" ou "SERVICE"
  contactJid     String
  customerPhone  String?
  customerName   String?
  rating         Int       // 1 a 5
  feedback       String?   @db.Text
  appointmentId  String?
  conversationId String?
  professionalId String?
  createdAt      DateTime  @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([tenantId, type, createdAt])
  @@index([tenantId, rating])
  @@index([tenantId, contactJid])
}

// ───────────────────────────── Observabilidade ─────────────────────────────

model SystemLog {
  id        String   @id @default(cuid())
  tenantId  String?
  level     LogLevel @default(INFO)
  source    String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
}

// Configurações globais do SaaS (SMTP para e-mails, notificações e parâmetros do sistema)
model SystemSetting {
  id                        String   @id @default("global")
  smtpHost                  String?
  smtpPort                  Int?     @default(587)
  smtpUser                  String?
  smtpPass                  String?
  smtpFrom                  String?
  smtpSecure                Boolean  @default(false)
  emailNotificationsEnabled Boolean  @default(true)

  // Integração Mercado Pago para Assinaturas SaaS
  mpAccessToken             String?
  mpPublicKey               String?
  mpWebhookSecret           String?
  mpSandbox                 Boolean  @default(false)
  mpEnabled                 Boolean  @default(false)

  updatedAt                 DateTime @updatedAt
}

enum SaaSPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  EXPIRED
  CANCELED
}

model SaaSPayment {
  id             String            @id @default(cuid())
  tenantId       String
  planId         String
  amountCents    Int
  method         PaymentMethod     @default(PIX)
  status         SaaSPaymentStatus @default(PENDING)
  mpPaymentId    String?           @unique
  mpStatus       String?
  mpStatusDetail String?
  qrCode         String?           @db.Text
  qrCodeBase64   String?           @db.Text
  ticketUrl      String?
  installments   Int?              @default(1)
  cardBrand      String?
  cardLastFour   String?
  payerEmail     String?
  payerName      String?
  payerDoc       String?
  paidAt         DateTime?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([mpPaymentId])
}

