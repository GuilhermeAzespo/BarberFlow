// ─────────────────────────────────────────────────────────────
// BarberFlow — Prisma Schema
//
// Estratégia multi-tenant: banco compartilhado + isolamento lógico.
// Toda entidade de negócio carrega `tenantId` (FK com ON DELETE CASCADE)
// e índices compostos iniciados por `tenantId`, garantindo que todas as
// consultas sejam filtradas e performáticas por salão.
//
// Valores monetários são armazenados em centavos (Int) para evitar
// erros de ponto flutuante. Datas são persistidas em UTC; o fuso de
// cada salão fica em `Tenant.timezone`.
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  SUPER_ADMIN // Gestão do SaaS (sem tenant)
  OWNER // Dono do salão
  MANAGER // Gerente/recepção
  PROFESSIONAL // Profissional com acesso ao painel
}

enum TenantStatus {
  ACTIVE
  SUSPENDED // Suspensão administrativa (suporte, abuso, solicitação)
  BLOCKED // Bloqueio por inadimplência
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
  DELAYED
}

enum AppointmentSource {
  PANEL
  WHATSAPP
  WEB
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  OTHER
}

enum WhatsAppStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ─────────────────────────── SaaS / Billing ───────────────────────────

model Plan {
  id                      String         @id @default(cuid())
  name                    String
  slug                    String         @unique
  description             String?
  priceCents              Int            @default(0)
  // null = ilimitado
  maxProfessionals        Int?
  maxAppointmentsPerMonth Int?
  whatsappEnabled         Boolean        @default(true)
  isActive                Boolean        @default(true)
  isDefault               Boolean        @default(false)
  sortOrder               Int            @default(0)
  features                Json?
  badge                   String?
  isHighlighted           Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  subscriptions           Subscription[]
  saasPayments            SaaSPayment[]
}

model Tenant {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  customDomain        String?      @unique
  logoUrl             String?
  phone               String?
  email               String?
  address             String?
  bio                 String?
  instagram           String?
  coverUrl            String?
  timezone            String       @default("America/Sao_Paulo")
  currency            String       @default("BRL")
  slotIntervalMinutes Int          @default(30)
  onboardingCompleted Boolean      @default(false)
  status              TenantStatus @default(ACTIVE)
  statusReason        String?
  statusChangedAt     DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  subscription          Subscription?
  logo                  TenantLogo?
  cover                 TenantCover?
  galleryImages         TenantGalleryImage[]
  users                 User[]
  businessHours         BusinessHour[]
  professionals         Professional[]
  services              Service[]
  customers             Customer[]
  appointments          Appointment[]
  transactions          Transaction[]
  whatsAppConfig        WhatsAppConfig?
  whatsAppSessionKeys   WhatsAppSessionKey[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  satisfactionSurveys   SatisfactionSurvey[]
  saasPayments          SaaSPayment[]
  fiscalConfig          FiscalConfig?
  nfseInvoices          NfseInvoice[]
  logs                  SystemLog[]
  loyaltyConfig         LoyaltyConfig?
  loyaltyCards          LoyaltyCard[]
  marketingConfig       MarketingConfig?
  marketingLogs         MarketingMessageLog[]
  clubPlans             ClubPlan[]
  customerSubscriptions CustomerSubscription[]
  paymentConfig         TenantPaymentConfig?

  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id                       String             @id @default(cuid())
  tenantId                 String             @unique
  planId                   String
  status                   SubscriptionStatus @default(TRIALING)
  trialEndsAt              DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  canceledAt               DateTime?
  lastPaymentAt            DateTime?
  // Ajustes de limite por cliente (sobrescrevem o plano quando definidos)
  maxProfessionalsOverride Int?
  maxAppointmentsOverride  Int?
  // Módulo Add-on de Emissão de NFS-e contratado à parte (ou liberado pelo Super Admin)
  nfseAddonActive          Boolean            @default(false)
  nfseAddonExpiresAt       DateTime?
  autoRenew                Boolean            @default(true)
  notes                    String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
}

model TenantLogo {
  tenantId  String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantCover {
  tenantId  String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantGalleryImage {
  id        String   @id @default(cuid())
  tenantId  String
  title     String?
  mimeType  String
  data      Bytes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sortOrder])
}

// ───────────────────────────── Identidade ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(OWNER)
  permissions  Json?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional?
  transactions Transaction[]

  @@index([tenantId])
}

// ─────────────────────────── Configurações ───────────────────────────

model BusinessHour {
  id         String  @id @default(cuid())
  tenantId   String
  // 0 = domingo ... 6 = sábado
  weekday    Int
  isOpen     Boolean @default(true)
  // Formato HH:mm no fuso do salão
  openTime   String  @default("09:00")
  closeTime  String  @default("19:00")
  breakStart String?
  breakEnd   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
}

// ───────────────────────────── Operação ─────────────────────────────

model Professional {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String?  @unique
  name              String
  phone             String?
  email             String?
  avatarUrl         String?
  color             String   @default("#C9A227")
  commissionPercent Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services            ProfessionalService[]
  appointments        Appointment[]
  satisfactionSurveys SatisfactionSurvey[]
  avatar              ProfessionalAvatar?

  @@index([tenantId, isActive])
}

model ProfessionalAvatar {
  professionalId String       @id
  mimeType       String
  data           Bytes
  updatedAt      DateTime     @updatedAt

  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  promoPriceCents Int?
  promoTitle      String?
  promoActive     Boolean   @default(false)
  promoExpiresAt  DateTime?
  promoDaysOfWeek Int[]     @default([])
  isActive        Boolean   @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]
  clubPlanServices ClubPlanService[]
  clubUsages       ClubUsage[]

  @@index([tenantId, isActive])
}

// Profissional sem nenhum vínculo = atende todos os serviços.
model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  // Apenas dígitos, com DDI (ex: 5511999998888)
  phone        String?
  whatsappJid  String?
  email        String?
  birthDate    DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  loyaltyCard  LoyaltyCard?
  marketingLogs MarketingMessageLog[]
  clubSubscriptions CustomerSubscription[]

  @@unique([tenantId, phone])
  @@unique([tenantId, whatsappJid])
  @@index([tenantId, name])
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  customerId     String
  professionalId String
  serviceId      String
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(SCHEDULED)
  source         AppointmentSource @default(PANEL)
  priceCents     Int
  notes          String?
  reminderSentAt DateTime?
  canceledAt     DateTime?
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service             Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  transaction         Transaction?
  satisfactionSurveys SatisfactionSurvey[]
  nfseInvoice         NfseInvoice?
  loyaltyTransactions LoyaltyTransaction[]
  clubUsages          ClubUsage[]

  @@index([tenantId, startAt])
  @@index([tenantId, professionalId, startAt])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([reminderSentAt, startAt])
}

model Transaction {
  id            String          @id @default(cuid())
  tenantId      String
  type          TransactionType
  category      String
  description   String?
  amountCents   Int
  paymentMethod PaymentMethod   @default(CASH)
  occurredAt    DateTime        @default(now())
  appointmentId String?         @unique
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, type, occurredAt])
}

// ───────────────────────────── WhatsApp ─────────────────────────────

model WhatsAppConfig {
  id                  String         @id @default(cuid())
  tenantId            String         @unique
  status              WhatsAppStatus @default(DISCONNECTED)
  phoneNumber         String?
  botEnabled          Boolean        @default(true)
  welcomeMessage      String         @db.Text
  confirmationMessage String         @db.Text
  reminderMessage     String         @db.Text
  cancellationMessage String         @db.Text
  reminderEnabled     Boolean        @default(true)
  reminderHoursBefore Int            @default(2)
  attendantSurveyEnabled Boolean     @default(true)
  attendantSurveyMessage String?     @db.Text
  serviceSurveyEnabled   Boolean     @default(true)
  serviceSurveyMessage   String?     @db.Text
  lastConnectedAt     DateTime?
  lastDisconnectedAt  DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Credenciais/chaves Signal da sessão Baileys persistidas no Postgres
// (o container fica stateless: reinícios/deploys não derrubam a sessão).
model WhatsAppSessionKey {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

// Estado da conversa do bot / chat de atendimento por contato.
model WhatsAppConversation {
  id            String            @id @default(cuid())
  tenantId      String
  contactJid    String
  phone         String?
  contactName   String?
  state         String            @default("MENU")
  isAttendant   Boolean           @default(false)
  unreadCount   Int               @default(0)
  lastMessage   String?           @db.Text
  context       Json              @default("{}")
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@unique([tenantId, contactJid])
  @@index([tenantId, isAttendant, lastMessageAt])
}

// Histórico de mensagens do chat do WhatsApp (recebidas e enviadas).
model WhatsAppMessage {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  contactJid     String
  fromMe         Boolean  @default(false)
  senderType     String   @default("CUSTOMER") // CUSTOMER, BOT, ATTENDANT, SYSTEM
  senderName     String?
  body           String   @db.Text
  status         String   @default("SENT") // SENT, DELIVERED, READ
  createdAt      DateTime @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, contactJid])
}

// Pesquisa de Satisfação (Atendimento Humano ou Pós-Corte/Agendamento).
model SatisfactionSurvey {
  id             String    @id @default(cuid())
  tenantId       String
  type           String    // "ATTENDANT" ou "SERVICE"
  contactJid     String
  customerPhone  String?
  customerName   String?
  rating         Int       // 1 a 5
  feedback       String?   @db.Text
  appointmentId  String?
  conversationId String?
  professionalId String?
  createdAt      DateTime  @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  @@index([tenantId, type, createdAt])
  @@index([tenantId, rating])
  @@index([tenantId, contactJid])
}

// ───────────────────────────── Observabilidade ─────────────────────────────

model SystemLog {
  id        String   @id @default(cuid())
  tenantId  String?
  level     LogLevel @default(INFO)
  source    String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([level, createdAt])
  @@index([source, createdAt])
}

// Configurações globais do SaaS (SMTP para e-mails, notificações e parâmetros do sistema)
model SystemSetting {
  id                        String   @id @default("global")
  smtpHost                  String?
  smtpPort                  Int?     @default(587)
  smtpUser                  String?
  smtpPass                  String?
  smtpFrom                  String?
  smtpSecure                Boolean  @default(false)
  emailNotificationsEnabled Boolean  @default(true)

  // Integração Mercado Pago para Assinaturas SaaS
  mpAccessToken             String?
  mpPublicKey               String?
  mpWebhookSecret           String?
  mpSandbox                 Boolean  @default(false)
  mpEnabled                 Boolean  @default(false)

  // Integração Cloudflare for SaaS (Provisionamento automático de SSL para Domínios Próprios)
  cfApiToken                String?
  cfZoneId                  String?
  cfFallbackOrigin          String?  @default("barberflow.azespo.com.br")
  cfEnabled                 Boolean  @default(false)

  // Preço do Módulo Add-on de NFS-e avulso (em centavos, padrão R$ 29,90)
  nfseAddonPriceCents       Int      @default(2990)

  updatedAt                 DateTime @updatedAt
}

enum SaaSPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  EXPIRED
  CANCELED
}

model SaaSPayment {
  id             String            @id @default(cuid())
  tenantId       String
  planId         String
  amountCents    Int
  method         PaymentMethod     @default(PIX)
  status         SaaSPaymentStatus @default(PENDING)
  mpPaymentId    String?           @unique
  mpStatus       String?
  mpStatusDetail String?
  qrCode         String?           @db.Text
  qrCodeBase64   String?           @db.Text
  ticketUrl      String?
  installments   Int?              @default(1)
  cardBrand      String?
  cardLastFour   String?
  payerEmail     String?
  payerName      String?
  payerDoc       String?
  paidAt         DateTime?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([mpPaymentId])
}

// ────────────────────── Módulo Fiscal / NFS-e (Padrão Nacional) ──────────────────────

model FiscalConfig {
  id                        String    @id @default(cuid())
  tenantId                  String    @unique
  enabled                   Boolean   @default(false)
  // "HOMOLOGATION" (Testes / Produção Restrita) ou "PRODUCTION" (Sefin Nacional com validade jurídica)
  environment               String    @default("HOMOLOGATION")
  // "ADN_NACIONAL" (Emissor Nativo Custo Zero via Certificado A1) ou "EXTERNAL_API" (Gateway opcional do salão)
  providerMode              String    @default("ADN_NACIONAL")

  cnpj                      String?
  razaoSocial               String?
  nomeFantasia              String?
  inscricaoMunicipal        String?
  codigoMunicipioIbge       String?   @default("3550308")
  uf                        String?   @default("SP")
  cep                       String?
  logradouro                String?
  numero                    String?
  bairro                    String?
  complemento               String?

  // "MEI" | "SIMPLES_NACIONAL" | "LUCRO_PRESUMIDO"
  regimeTributario          String    @default("MEI")
  // 2 = MEI (Simples Nacional), 3 = ME/EPP (Simples Nacional), 1 = Não Optante
  optanteSimples            Int       @default(2)
  itemListaServico          String    @default("06.01")
  codigoTributacaoNacional  String    @default("060101")
  codigoTributacaoMunicipal String?
  cnae                      String?   @default("9602501")
  aliquotaIss               Float     @default(2.0)
  retencaoIss               Boolean   @default(false)
  serieDps                  String    @default("1")
  proximoNumeroDps          Int       @default(1)

  // Lei do Salão-Parceiro (Lei nº 13.352/2016) — deduz a cota-parte do barbeiro da base de cálculo
  salaoParceiroEnabled      Boolean   @default(false)
  // Automações
  autoEmitOnComplete        Boolean   @default(false)
  autoSendWhatsApp          Boolean   @default(true)

  // Certificado Digital e-CNPJ A1 (.pfx) do próprio salão
  certPfxData               Bytes?
  certPassword              String?
  certSubject               String?
  certIssuer                String?
  certValidTo               DateTime?
  certUploadedAt            DateTime?

  // Opcional: API externa caso o salão utilize integrador municipal próprio
  externalApiUrl            String?
  externalApiToken          String?

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant                    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model NfseInvoice {
  id                        String    @id @default(cuid())
  tenantId                  String
  appointmentId             String?   @unique
  transactionId             String?
  customerId                String?

  // "PROCESSING" | "AUTHORIZED" | "REJECTED" | "CANCELED"
  status                    String    @default("AUTHORIZED")
  environment               String    @default("HOMOLOGATION")

  numeroDps                 Int
  serieDps                  String    @default("1")
  numeroNfse                String?
  chaveAcesso               String?
  codigoVerificacao         String?

  tomadorNome               String
  tomadorDocumento          String?
  tomadorEmail              String?
  tomadorTelefone           String?

  discriminacao             String    @db.Text
  valorBrutoCents           Int
  valorDeducaoParceiroCents Int       @default(0)
  baseCalculoCents          Int
  aliquotaIss               Float     @default(0)
  valorIssCents             Int       @default(0)
  valorLiquidoCents         Int

  profissionalParceiroNome  String?
  profissionalParceiroDoc   String?

  xmlDps                    String?   @db.Text
  xmlNfse                   String?   @db.Text
  urlDanfse                 String?
  errorMessage              String?   @db.Text
  whatsappSentAt            DateTime?

  issuedAt                  DateTime  @default(now())
  canceledAt                DateTime?
  cancelReason              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant                    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment               Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, issuedAt])
  @@index([tenantId, status])
}

// ────────────────────── Módulo Cartão Fidelidade Digital Automático ──────────────────────

model LoyaltyConfig {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  enabled              Boolean  @default(true)
  targetStamps         Int      @default(10)
  rewardText           String   @default("1 Corte ou Barba Grátis")
  autoSendWhatsApp     Boolean  @default(true)
  showInPublicShowcase Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

enum LoyaltyTransactionType {
  STAMP_ADDED
  REWARD_REDEEMED
  MANUAL_ADJUSTMENT
}

model LoyaltyCard {
  id               String   @id @default(cuid())
  tenantId         String
  customerId       String   @unique
  currentStamps    Int      @default(0)
  completedCycles  Int      @default(0)
  rewardsAvailable Int      @default(0)
  lastStampAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@unique([tenantId, customerId])
  @@index([tenantId, customerId])
}

model LoyaltyTransaction {
  id            String                 @id @default(cuid())
  tenantId      String
  loyaltyCardId String
  type          LoyaltyTransactionType @default(STAMP_ADDED)
  stampsChange  Int                    @default(1)
  appointmentId String?
  notes         String?
  createdAt     DateTime               @default(now())

  loyaltyCard LoyaltyCard  @relation(fields: [loyaltyCardId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([loyaltyCardId, createdAt])
  @@index([tenantId, createdAt])
}

enum MarketingCampaignType {
  INACTIVE_RECOVERY
  BIRTHDAY
}

enum MarketingDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model MarketingConfig {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  enabled                 Boolean  @default(true)

  // Robô 1: Recuperação de Inativos ("Clientes Sumidos")
  inactiveRecoveryEnabled Boolean  @default(true)
  inactiveDaysThreshold   Int      @default(30)
  inactiveMessageTemplate String   @default("Olá, {cliente}! Sentimos sua falta aqui na {barbearia}. Que tal renovar o visual esta semana? Agende seu horário em 1 clique: {link}")
  inactiveDiscountPercent Int?

  // Robô 2: Aniversariantes do Dia
  birthdayEnabled         Boolean  @default(true)
  birthdayMessageTemplate String   @default("🎉 Parabéns, {cliente}! A equipe da {barbearia} deseja um feliz aniversário! Preparamos um presente especial para você: agende com desconto exclusivo pelo link: {link}")
  birthdayDiscountPercent Int?     @default(15)

  // Regras de Disparo & Anti-Ban
  sendWindowStart         String   @default("09:00")
  sendWindowEnd           String   @default("19:00")
  minDaysBetweenMessages  Int      @default(30)
  maxDailyDispatches      Int      @default(20)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MarketingMessageLog {
  id           String                  @id @default(cuid())
  tenantId     String
  customerId   String
  type         MarketingCampaignType
  status       MarketingDeliveryStatus @default(SENT)
  phone        String
  message      String
  errorMessage String?
  sentAt       DateTime                @default(now())

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, type, sentAt])
  @@index([tenantId, customerId, sentAt])
}

enum ClubSubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  CANCELED
  EXPIRED
}

model ClubPlan {
  id                String                 @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  priceCents        Int
  maxUsagesPerMonth Int?
  allowedDaysOfWeek Int[]                  @default([])
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services          ClubPlanService[]
  subscriptions     CustomerSubscription[]

  @@index([tenantId, isActive])
}

model ClubPlanService {
  planId    String
  serviceId String

  plan      ClubPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([planId, serviceId])
  @@index([serviceId])
}

model CustomerSubscription {
  id             String                 @id @default(cuid())
  tenantId       String
  customerId     String
  planId         String
  status         ClubSubscriptionStatus @default(ACTIVE)
  cycleStartDate DateTime               @default(now())
  cycleEndDate   DateTime
  usagesCount    Int                    @default(0)
  paymentMethod  String                 @default("MANUAL")
  lastPaymentAt  DateTime?
  autoRenew      Boolean                @default(true)
  mpLastPaymentId String?
  cardLastFour   String?
  cardBrand      String?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan           ClubPlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  usages         ClubUsage[]

  @@unique([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, cycleEndDate])
}

model ClubUsage {
  id             String               @id @default(cuid())
  tenantId       String
  subscriptionId String
  appointmentId  String?
  serviceId      String
  usedAt         DateTime             @default(now())
  notes          String?

  subscription   CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  appointment    Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  service        Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, usedAt])
  @@index([tenantId, usedAt])
}

// ────────────── Integração de Recebimentos Online por Salão (Mercado Pago Direto) ──────────────

model TenantPaymentConfig {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  enabled              Boolean  @default(false)
  mpPublicKey          String?
  mpAccessToken        String?
  mpWebhookSecret      String?
  pixEnabled           Boolean  @default(true)
  creditCardEnabled    Boolean  @default(true)
  recurringCardEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
